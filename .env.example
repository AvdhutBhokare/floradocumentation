# Optional satellite base map (Section 46 of the spec).
#
# The app ships with OpenStreetMap street tiles by default and works fully
# without this. To enable a "Satellite" base map option, sign up with a
# legitimate tile provider (e.g. Mapbox, MapTiler, Esri, Google Maps
# Platform) and set BOTH of these to a valid tile URL template and
# attribution string. Never commit real keys — this file is a template only.
#
# Example (MapTiler):
# VITE_SATELLITE_TILE_URL=https://api.maptiler.com/tiles/satellite/{z}/{x}/{y}.jpg?key=YOUR_KEY_HERE
# VITE_SATELLITE_TILE_ATTRIBUTION=© MapTiler © OpenStreetMap contributors

VITE_SATELLITE_TILE_URL=
VITE_SATELLITE_TILE_ATTRIBUTION=
